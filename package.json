{
  "name": "dsh-element-ref",
  "version": "0.1.0",
  "description": "Click any element and get a reference into the DSH composer — DSH itself, sidebar browser pages, the DSH agent browser and an external Edge/Chrome all run the same picker kernel.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cdp.js",
    "browsers.js",
    "agent.source.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DESIGN.md",
    "LICENSE",
    "NOTICE",
    "icon.svg",
    "extension",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.2.1-rc.1 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "node scripts/test.mjs && node scripts/check-pack.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "deepseek-harness",
    "element-picker",
    "reference"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sakikoTGW/dsh-element-picker.git"
  },
  "homepage": "https://github.com/sakikoTGW/dsh-element-picker#readme",
  "bugs": {
    "url": "https://github.com/sakikoTGW/dsh-element-picker/issues"
  },
  "author": "Knot-chord"
}
