{
  "manifest_version": 3,
  "name": "DSH Element Reference",
  "version": "1.0.4",
  "description": "Click any element in this browser and turn it into a reference chip in DeepSeek Harness. Start picking from the DSH sidebar icon.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["scripting", "tabs", "activeTab", "alarms"],
  "minimum_chrome_version": "120",
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["keepalive.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "DSH 元素引用：在 DSH 里点图标开始选取",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  }
}


